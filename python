import random
import time
import os

# Função para gerar CPF falso (formato brasileiro)
def gerar_cpf():
    cpf = [random.randint(0, 9) for _ in range(9)]
    # Cálculo dos dígitos verificadores (simplificado)
    d1 = sum((10 - i) * cpf[i] for i in range(9)) % 11
    d1 = 0 if d1 < 2 else 11 - d1
    cpf.append(d1)
    
    d2 = sum((11 - i) * cpf[i] for i in range(10)) % 11
    d2 = 0 if d2 < 2 else 11 - d2
    cpf.append(d2)
    return ''.join(map(str, cpf))

# Função para gerar RG falso
def gerar_rg():
    rg = ''.join(random.choices('0123456789', k=9))
    return f"{rg[:2]}.{rg[2:5]}.{rg[5:8]}-{rg[8]}"

# Função para gerar placa
def gerar_placa():
    letras = ''.join(random.choices('ABCDEFGHIJKLMNOPQRSTUVWXYZ', k=3))
    numeros = ''.join(random.choices('0123456789', k=4))
    return f"{letras}-{numeros}"

class Veiculo:
    def __init__(self):
        self.placa = gerar_placa()
        self.modelo = random.choice(["Gol", "Uno", "Onix", "HB20", "Corolla", "Civic", "Hilux", "S10", "Fusca"])
        self.cpf = gerar_cpf()
        self.rg = gerar_rg()
        self.horario_entrada = time.strftime("%H:%M")

    def __str__(self):
        return f"Placa: {self.placa} | Modelo: {self.modelo} | CPF: {self.cpf} | RG: {self.rg} | Entrada: {self.horario_entrada}"

class Estacionamento:
    def __init__(self, vagas_totais=20):
        self.vagas_totais = vagas_totais
        self.vagas = {}  # placa -> Veiculo

    def vagas_disponiveis(self):
        return self.vagas_totais - len(self.vagas)

    def estacionar(self):
        if self.vagas_disponiveis() <= 0:
            print("❌ Estacionamento lotado!")
            return False
        
        veiculo = Veiculo()
        self.vagas[veiculo.placa] = veiculo
        print(f"✅ Veículo estacionado com sucesso!")
        print(veiculo)
        return True

    def remover(self, placa):
        if placa in self.vagas:
            veiculo = self.vagas.pop(placa)
            print(f"🚗 Veículo removido:")
            print(veiculo)
            return True
        else:
            print("❌ Veículo não encontrado!")
            return False

    def mostrar_vagas(self):
        print(f"\n=== STATUS DO ESTACIONAMENTO ===")
        print(f"Vagas totais: {self.vagas_totais}")
        print(f"Vagas ocupadas: {len(self.vagas)}")
        print(f"Vagas sobrando: {self.vagas_disponiveis()}\n")
        
        if self.vagas:
            print("Veículos estacionados:")
            for veiculo in self.vagas.values():
                print(f"  • {veiculo}")
        else:
            print("Estacionamento vazio!")

# ===================== JOGO =====================
def limpar_tela():
    os.system('cls' if os.name == 'nt' else 'clear')

def main():
    estacionamento = Estacionamento(vagas_totais=15)
    
    while True:
        limpar_tela()
        print("🅿️  SIMULADOR DE ESTACIONAMENTO 🅿️\n")
        estacionamento.mostrar_vagas()
        
        print("\nEscolha uma opção:")
        print("1. Estacionar novo veículo (gera RG, CPF e placa)")
        print("2. Remover veículo")
        print("3. Mostrar vagas")
        print("4. Sair")
        
        opcao = input("\nDigite a opção: ").strip()
        
        if opcao == "1":
            estacionamento.estacionar()
        elif opcao == "2":
            placa = input("Digite a placa do veículo (ex: ABC-1234): ").upper().strip()
            estacionamento.remover(placa)
        elif opcao == "3":
            estacionamento.mostrar_vagas()
        elif opcao == "4":
            print("👋 Obrigado por usar o simulador!")
            break
        else:
            print("Opção inválida!")
        
        input("\nPressione ENTER para continuar...")

if __name__ == "__main__":
    main()